# ===========================================================================
# CANONICAL ENVIRONMENT VARIABLES - synkra--web
# Canonical names are primary. Legacy names are kept as working fallbacks
# for ONE deploy cycle only, then removed.
# Never put a secret in a VITE_ variable - those are embedded in the browser
# bundle at build time (Coolify: Build Arguments).
# ===========================================================================

# --- Shared PocketBase instance -------------------------------------------
# CANONICAL (public/client, build-time)
VITE_SYNKRA_PB_URL=https://os.synkra.co.za
# CANONICAL (server-only, runtime)
SYNKRA_PB_URL=https://os.synkra.co.za
# LEGACY FALLBACK - remove after one deploy cycle
VITE_POCKETBASE_URL=https://os.synkra.co.za
POCKETBASE_URL=https://os.synkra.co.za

# --- This app's own public base URL (not shared with other apps) ----------
# CANONICAL
SYNKRA_APP_URL=https://synkra.co.za

# --- Payments (server-only secret) ----------------------------------------
PAYSTACK_SECRET_KEY=

# --- PocketBase service account for this app ------------------------------
# A scoped service account on the shared instance - NOT the Agency Portal's
# account and NOT a superuser shared with another app.
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# --- Per-service tokens (one per consumer, never shared) ------------------
# Utilities API (public base URL, no credential)
VITE_UTILITIES_API_URL=https://utilities-api.synkra.co.za
# synkra-core quote engine
CORE_API_URL=https://api.synkra.co.za
SYNKRA_INTERNAL_SECRET=
# synkra-client-hub checkout
CLIENT_HUB_API_URL=https://flow.synkra.co.za
CLIENT_HUB_API_SECRET=

# --- Local AI scoring (server-side only) ----------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Email --------------------------------------------------------------
# DO NOT SET HERE. All transactional email is sent by synkra-os
# (RESEND_API_KEY / RESEND_FROM_ADDRESS live there only).

# --- Runtime --------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
