# ---------------------------------------------------------------------------
# BUILD-TIME (Coolify: Build Arguments). Vite embeds these in the browser
# bundle at docker build time. Never put a secret in a VITE_ variable.
# Migrated off Supabase - this is a NEW, dedicated PocketBase instance for
# this app only, separate from the one serving synkra-client-hub
# (pb.synkra.co.za). Do not point this at that instance.
# ---------------------------------------------------------------------------
VITE_POCKETBASE_URL=https://pb-web.synkra.co.za

# Base URL of synkra-utilities' FastAPI backend (see that repo's own
# .env.example / docker-compose.yml). Called directly from the browser.
VITE_UTILITIES_API_URL=https://utilities-api.synkra.co.za

# Integration Partner application: AI scoring (server-side only, never
# exposed to the browser) via Ollama already running on the server, and
# confirmation email.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=partnerships@synkra.co.za

# Agency qualification-form quote engine: calls synkra-core's
# /agency-quotes endpoint. SYNKRA_INTERNAL_SECRET must be the exact same
# value as synkra-core's own WEBHOOK_SECRET env var - this is a shared
# server-to-server secret, not a public API key.
CORE_API_URL=https://api.synkra.co.za
SYNKRA_INTERNAL_SECRET=must_match_synkra_core_WEBHOOK_SECRET

# Checkout now lives on this site (src/lib/checkout.functions.ts), but the
# actual account/PocketBase record, Paystack transaction, and welcome email
# are created by synkra-client-hub's POST /api/checkout. Same pattern as
# the two vars above: CLIENT_HUB_API_SECRET must be the exact same value as
# CHECKOUT_API_SECRET in that repo's own .env.
CLIENT_HUB_API_URL=https://flow.synkra.co.za
CLIENT_HUB_API_SECRET=must_match_synkra_client_hub_CHECKOUT_API_SECRET

# ---------------------------------------------------------------------------
# RUNTIME (Coolify: Environment Variables). Read by the Node server only -
# never shipped to the browser bundle.
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Server-side PocketBase access (admin.functions.ts, public.functions.ts,
# submit-form.ts, admin.upload.ts, auth-middleware.ts). Same instance as
# VITE_POCKETBASE_URL above, reachable server-side.
POCKETBASE_URL=https://pb-web.synkra.co.za

# Superuser credentials for client.server.ts (getPbAdmin()) - used only for
# inviteAdmin, removeAdmin, and media uploads. Provision this superuser
# manually in the PocketBase dashboard; do not reuse an admin_users account.
POCKETBASE_ADMIN_EMAIL=admin@synkra.co.za
POCKETBASE_ADMIN_PASSWORD=your_superuser_password

#IMPORTANT
VITE_POCKETBASE_URL=https://<your-shared-instance-host>
POCKETBASE_URL=https://<your-shared-instance-host>
POCKETBASE_ADMIN_EMAIL=<a new scoped service account on the shared instance — not the Agency Portal's or the adapter's>
POCKETBASE_ADMIN_PASSWORD=<...>
