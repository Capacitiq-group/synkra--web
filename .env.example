# ---------------------------------------------------------------------------
# BUILD-TIME (Coolify: Build Arguments). Vite embeds these in the browser
# bundle at docker build time. Never put a secret in a VITE_ variable.
# Still on Supabase — swap to VITE_POCKETBASE_URL (see synkra-client-hub's
# .env.example) once the Supabase -> PocketBase migration for this app is
# scoped and done. Do not do that swap as part of this deployment change.
# ---------------------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_URL=your_supabase_url

# ---------------------------------------------------------------------------
# RUNTIME (Coolify: Environment Variables). Read by the Node server only.
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
